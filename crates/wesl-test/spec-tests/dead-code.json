[
	{
		"name": "strip-import-unused-declaration",
		"desc": "",
		"kind": "modules",
		"code": "import package::m1::foo; fn main() { foo(); }",
		"modules": {
			"package::m1": "fn foo() { } fn bar() { }"
		},
		"expect": "pass",
		"result": "fn main() { package_m1_foo(); } fn package_m1_foo() { }"
	},
	{
		"name": "strip-import-const-asserts-if-module-unused",
		"desc": "",
		"kind": "modules",
		"code": "import package::m1::unused; fn main() { }",
		"modules": {
			"package::m1": "const_assert true; fn foo() { } fn unused() { }"
		},
		"expect": "pass",
		"result": "fn main() { }"
	},
	{
		"name": "strip-deep-import-unused-module",
		"desc": "",
		"kind": "modules",
		"code": "import package::m1::foo; fn main() { foo(); }",
		"modules": {
			"package::m1": "import package::m2::bar; fn foo() { } fn unused() { bar(); }",
			"package::m2": "const_assert false; fn bar() { }"
		},
		"expect": "pass",
		"result": "fn main() { package_m1_foo(); } fn package_m1_foo() { }"
	},
	{
		"name": "keep-import-const-asserts-if-module-used",
		"desc": "",
		"kind": "modules",
		"code": "import package::m1::foo; fn main() { foo(); }",
		"modules": {
			"package::m1": "const_assert true; fn foo() { } fn bar() { }"
		},
		"expect": "pass",
		"result": "fn main() { package_m1_foo(); } const_assert true; fn package_m1_foo() { }"
	},
	{
		"name": "strip-compound-decl",
		"desc": "",
		"kind": "modules",
		"code": "{ fn foo() {} } fn main() { }",
		"expect": "pass",
		"result": "fn main() { }"
	},
	{
		"name": "keep-used-compound-decl",
		"desc": "",
		"kind": "modules",
		"code": "import package::m1::foo; fn main() { foo(); }",
		"modules": {
			"package::m1": "@if (true) { const_assert true; fn foo() {} fn bar() {} }"
		},
		"expect": "pass",
		"result": "fn main() { package_m1_foo(); } const_assert true; fn package_m1_foo() { }"
	}
]
