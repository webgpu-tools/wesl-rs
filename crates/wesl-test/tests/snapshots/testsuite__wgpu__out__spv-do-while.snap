fn fb1_(cond: ptr<function, bool>) {
    loop {
        continue;
        continuing {
            let _e1: bool = (*cond);
            break if !(_e1);
        }
    }
    return;
}

@fragment
fn main() {
    main_1();
}

fn main_1() {
    var param: bool;
    param = false;
    fb1_((&param));
    return;
}
